# ── Supabase ───────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App ────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Pulse
VITE_APP_URL=http://localhost:5173

# ── Storage ────────────────────────────────────────────────────────────────────
# Supabase Storage bucket name for chat images
VITE_STORAGE_BUCKET=chat-images
# Max image upload size in bytes (default: 5MB)
VITE_MAX_IMAGE_SIZE=5242880

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_IMAGE_UPLOAD=true
VITE_ENABLE_GROUP_CHAT=true
